# Copy these into your local environment and fill in your real SMTP values.
# Example for Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_PORT=587
# SMTP_SCHEME=smtp
# SMTP_ENCRYPTION=tls
# APP_SENDER_EMAIL=your-email@gmail.com
# APP_SENDER_NAME="Visitor Management System"
# APP_FRONTEND_HOST=http://localhost:8080

# Alternative DSN-based transport:
# SMTP_DSN=smtp://user:pass@smtp.example.com:587
